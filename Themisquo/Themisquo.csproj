<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<PackageId>Themisquo</PackageId>
		<RootNamespace>Themisquo</RootNamespace>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Themisquo - a CQRS-ES core library</Title>
		<PackageIcon>Themisquo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/TVolden/Themisquo</RepositoryUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<Authors>Thomas Volden</Authors>
		<Version>0.4.0</Version>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="..\Themisquo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
	</ItemGroup>

	<!-- Ship the analyzers (e.g. THQ001) inside this package so consumers get them automatically. -->
	<ItemGroup>
		<ProjectReference Include="..\Themisquo.Analyzers\Themisquo.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<None Include="..\Themisquo.Analyzers\bin\$(Configuration)\netstandard2.0\Themisquo.Analyzers.dll" Visible="false">
			<Pack>True</Pack>
			<PackagePath>analyzers\dotnet\cs</PackagePath>
		</None>
	</ItemGroup>

</Project>
